# ---------------------------------------------------------------------------
# MagxTV - environment configuration
# Copy to .env and fill in. Nothing here is required to run the demo build.
# ---------------------------------------------------------------------------

# ---------- API server ----------
PORT=8787
NODE_ENV=development
# PostgreSQL. When DATABASE_URL is empty the API uses its in-memory demo store
# (auth, favourites and admin data then reset on restart).
DATABASE_URL=postgresql://magx:magx@localhost:5432/magxtv

# ---------- Authentication ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Sports data provider ----------
# mock   -> bundled demo catalogue, every payload is flagged demo:true
# xtream -> YOUR OWN licensed Xtream Codes compatible panel (never a third party reseller)
SPORTS_PROVIDER=mock
SPORTS_API_BASE_URL=
SPORTS_API_USER=
SPORTS_API_PASS=
SPORTS_API_KEY=

# ---------- Playback ----------
# Comma separated hostnames allowed as stream sources. The player and the API
# both refuse anything that is not on this list.
STREAM_ALLOWLIST=test-streams.mux.dev,commondatastorage.googleapis.com

# ---------- Web app ----------
# Leave empty to run fully client-side on the bundled demo catalogue.
VITE_API_BASE_URL=http://localhost:8787
