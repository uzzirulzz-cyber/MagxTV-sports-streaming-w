{
  "name": "magxtv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MagxTV - live sports streaming platform (React + TypeScript web app, Express + PostgreSQL API)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173 --host",
    "api": "tsx watch server/src/index.ts",
    "db:migrate": "tsx server/src/migrate.ts",
    "demo": "tsx server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hls.js": "^1.5.17",
    "jsonwebtoken": "^9.0.2",
    "mpegts.js": "^1.8.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
